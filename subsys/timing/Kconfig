config TIMING_FUNCTIONS
	bool "Timing Functions"
	help
	  When enabled, timing related functions are compiled. This is
	  useful for gathering timing on code execution.

config TIMING_FUNCTIONS_NEED_AT_BOOT
	bool
	select TIMING_FUNCTIONS
	help
	  Hidden option to indicate that timing functions need to be
	  initialized at boot.

	  To be selected by kernel and other subsystems which need
	  to use timing functions.

DT_CHOSEN_ZEPHYR_TIMING_COUNTER := zephyr,timing-counter

config TIMING_SYS_CLOCK
	bool "Timing functions backed by the system clock"
	depends on TIMER_HAS_64BIT_CYCLE_COUNTER
	depends on !TIMING_COUNTER
	select TIMING_FUNCTIONS
	select SOC_HAS_TIMING_FUNCTIONS
	help
	  Implement the timing API on k_cycle_get_64(), for system timers whose cycle count is
	  fine-grained and keeps advancing in every sleep state the system enters, such as
	  CLOCK_EVENT_SYSTEM_TIMER. The CPU cycle counter stops in sleep; this does not.

config TIMING_COUNTER
	bool "Timing functions backed by a Counter device"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_ZEPHYR_TIMING_COUNTER))
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_ZEPHYR_TIMING_COUNTER))
	select COUNTER
	select TIMING_FUNCTIONS
	select SOC_HAS_TIMING_FUNCTIONS
	help
	  Implement the timing API (timing_counter_get(), timing_cycles_get(), timing_ns_get(), ...)
	  on top of the Counter device chosen as "zephyr,timing-counter", for SoCs that have no
	  timing backend of their own and where the CPU cycle counter is not suitable (it stops in
	  sleep, and it only exists on some cores).

	  The value returned by timing_counter_get() is 64 bits wide. The hardware count is folded
	  into it whenever the clock is read, and an alarm armed half a counter period ahead of the
	  last fold guarantees that it is folded often enough even if nobody reads the clock.

	  The chosen counter must be free-running, must support one alarm channel, and must keep
	  counting in every sleep state the system enters (for example an RTC). This option does
	  not restrict sleeping.
